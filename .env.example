# Django Backend Environment Variables
# ─── Local Development ───
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Database — leave empty for SQLite, or use Supabase PostgreSQL URL:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Production (Render) ───
# DEBUG=False
# SECRET_KEY=<auto-generated-by-render>
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# ALLOWED_HOSTS=.onrender.com,fasalytics.vercel.app
# CORS_ALLOWED_ORIGINS=https://fasalytics.vercel.app
# CSRF_TRUSTED_ORIGINS=https://fasalytics.vercel.app
